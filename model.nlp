          {
            "answer": "If you're having trouble logging in, double-check your credentials or reset your password."
          }
        ],
        "general.signup": [
          {
            "answer": "\nStep 1: Click The Sign Up Button \nStep 2: Fill Out Form \nStep 3: If you do not know your Access Code, get with your manager"
          }
        ],
        "auth.reset": [
          {
            "answer": "Go to the login page and click \"Forgot Password\" to reset it."
          }
        ],
        "general.help": [
          {
            "answer": "This bug tracker helps your team manage and fix issues efficiently."
